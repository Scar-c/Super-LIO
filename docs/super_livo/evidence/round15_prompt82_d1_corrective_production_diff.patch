+  test_p82_t11_sequential_prior_full_19d();
+  test_p82_t9_t10_config_provenance();
+  test_p82_m1_zero_init_variance_rejected();
   std::printf("ROUND15 D1 EXPOSURE STATE TDD: ALL PASS\n");
   return 0;
 }
